APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
CLOCKWORK_ENABLE=false
APP_URL="https://fmtrx.com"
API_ENDPOINT="https://fmtrx.com/api/"
DATA_HUB_MAX_FILE_SIZE_BYTES=26214400
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
APP_TIMEZONE=America/El_Salvador
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fmtrx
DB_USERNAME=fmtrx_app
DB_PASSWORD=replace_with_a_unique_secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Temporary evaluation window. Both values are required. Use an ISO-8601
# timestamp with an explicit timezone; access turns off automatically at expiry.
FMTRX_TEMPORARY_FULL_ACCESS_ENABLED=false
FMTRX_TEMPORARY_FULL_ACCESS_ENDS_AT=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=465
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key_here
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="passwordreset@fmtrx.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID="your_aws_key_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_here"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fungometrics
AWS_PUBLIC_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

TWILIO_SID="your_twilio_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_NUMBER="your_twilio_number_here"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# RevenueCat server-only configuration. Never expose these in React Native.
REVENUECAT_ENVIRONMENT=test
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_SANDBOX_STORES=TEST_STORE

FMTRX_PRIVACY_URL="https://app.fmtrx.com/privacy"
FMTRX_TERMS_URL="https://app.fmtrx.com/terms"
FMTRX_SUPPORT_URL="https://app.fmtrx.com/support"
FMTRX_ACCOUNT_DELETION_URL="https://app.fmtrx.com/account-deletion"

# Compute CageDistanceService v2 alongside the existing cage distance on save.
# Off by default — see config/fmtrx.php.
FMTRX_CAGE_DISTANCE_V2_ENABLED=false

# Dev/admin-only Cage Distance Validation Lab preview endpoint. Off by default,
# including in production — see config/fmtrx.php.
CAGE_DISTANCE_VALIDATION_ENABLED=false
