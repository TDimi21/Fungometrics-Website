; Review before installation. Replace every __...__ placeholder.
; Do not also enable a Plesk Toolkit worker for these queues.
[program:fmtrx-communications]
process_name=%(program_name)s_%(process_num)02d
command=__PHP_BINARY__ __APP_ROOT__/artisan queue:work database --queue=communications --sleep=3 --tries=1 --timeout=60 --memory=256
directory=__APP_ROOT__
user=__APP_USER__
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
numprocs=1
redirect_stderr=true
stdout_logfile=__APP_ROOT__/storage/logs/communications-worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
stopwaitsecs=90

; The switch from sync also affects pre-existing jobs on the default queue.
[program:fmtrx-default]
process_name=%(program_name)s_%(process_num)02d
command=__PHP_BINARY__ __APP_ROOT__/artisan queue:work database --queue=default --sleep=3 --tries=1 --timeout=60 --memory=256
directory=__APP_ROOT__
user=__APP_USER__
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
numprocs=1
redirect_stderr=true
stdout_logfile=__APP_ROOT__/storage/logs/default-worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
stopwaitsecs=90
